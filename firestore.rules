rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pitches collection: readable by all, writeable by authenticated or dev users
    match /pitches/{pitchId} {
      allow read: if true;
      allow write: if request.auth != null || request.time < timestamp.date(2026, 12, 31);

      // Real-time messages subcollection
      match /messages/{messageId} {
        allow read: if true;
        allow create: if request.auth != null || request.time < timestamp.date(2026, 12, 31);
        allow update, delete: if request.auth != null;
      }

      // Real-time players subcollection (check-ins)
      match /players/{playerId} {
        allow read: if true;
        allow write: if request.auth != null || request.time < timestamp.date(2026, 12, 31);
      }
    }

    // Baller Card user profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null || request.time < timestamp.date(2026, 12, 31);
    }

    // Default open for 60 days for smooth setup
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 12, 31);
    }
  }
}
